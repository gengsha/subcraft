{
  "name": "subcraft-app",
  "version": "0.2.3",
  "private": true,
  "description": "SubCraft - 视频语音识别的双语字幕生成软件",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:47654 && cross-env ELECTRON_RENDERER_URL=http://localhost:47654 electron .\"",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && electron-builder --win zip portable nsis",
    "pack:win": "npm run build && electron-builder --win zip portable",
    "pack:linux": "npm run build && electron-builder --linux --config build.linux.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "jassub": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.subcraft.app",
    "productName": "SubCraft",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/subcraft-backend.exe",
        "to": "backend/subcraft-backend.exe"
      },
      {
        "from": "../tools/ffmpeg",
        "to": "tools/ffmpeg",
        "filter": [
          "**/*",
          "!ffplay.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SubCraft-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SubCraft-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "SubCraft-Setup-${version}.exe"
    }
  }
}
