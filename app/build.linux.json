{
  "appId": "com.subcraft.subtitle",
  "productName": "SubCraft",
  "directories": {
    "output": "../release/linux"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "../backend/app",
      "to": "backend/app"
    },
    {
      "from": "../backend/run.py",
      "to": "backend/run.py"
    },
    {
      "from": "../backend/requirements.txt",
      "to": "backend/requirements.txt"
    }
  ],
  "linux": {
    "target": [
      "tar.gz"
    ],
    "category": "AudioVideo",
    "artifactName": "SubCraft-${version}-x64-linux.tar.gz"
  }
}
